# .gitignore for tsmp (restructured, deduplicated and commented)
# Keep generated files, build artifacts, IDE caches, and local dependency stores out of git.

# -----------------------------------------------------------------------------
# R / RStudio temporary and history files
# -----------------------------------------------------------------------------
# History and session
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# RStudio project files
.Rproj.user/

# knitr / rmarkdown caches and temporary outputs
*_cache/
cache/
*.utf8.md
*.knit.md

# knitr / bookdown generated directories
/*_files/

# OAuth token (don't commit)
.httr-oauth

# -----------------------------------------------------------------------------
# Package build & check artifacts
# -----------------------------------------------------------------------------
# R CMD build outputs
*.tar.gz

# R CMD check output
*.Rcheck/

# CRAN release marker
CRAN-RELEASE

# Example code generated by package build process
*-Ex.R

# produced vignettes (keep sources, ignore built outputs)
vignettes/*.html
vignettes/*.pdf
vignettes/*.R

# -----------------------------------------------------------------------------
# Documentation site (pkgdown) and doc folders
# - Ignore generated site output unless you intentionally version the site
# -----------------------------------------------------------------------------
pkgdown/
docs/
doc/

# -----------------------------------------------------------------------------
# Local dependency managers
# - Commit lockfiles; ignore installed libraries and caches
# -----------------------------------------------------------------------------
# renv
renv/library/
renv/cache/

# packrat (older)
packrat/lib*/
packrat/src/

# revdep helper folders (local checks)
revdep/checks
revdep/checks.noindex
revdep/library
revdep/library.noindex
revdep/data.sqlite
revdep/*.html

# -----------------------------------------------------------------------------
# Native / compiled objects (from src/)
# -----------------------------------------------------------------------------
src/*.o
src/*.so
src/*.dll
src/*.dylib
src/*.exe
src/*.obj
src/*.a
src/*.lib
src/*.gc*

# src-*/ (some user added pattern)
src-*/

# -----------------------------------------------------------------------------
# IDEs, editors and project files
# -----------------------------------------------------------------------------
.vscode/
.idea/
workspace.RData
.Renviron
.Rprofile
LOCAL_APPDATA_FONTCONFIG_CACHE/

# -----------------------------------------------------------------------------
# OS files and misc
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Rplots.pdf

# Miscellaneous logs and coverage
*.log
coverage/
covr/

# Misc duplicates / common temp files
.history

# dev/ docs used by some workflows (keep ignored if generated locally)
dev/

# Meta and packaging metadata
Meta/

# End of file
dev/

